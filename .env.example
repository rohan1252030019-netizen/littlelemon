# Copy this file to .env and adjust the values for your machine.

# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database (MySQL)
# Set DB_ENGINE=sqlite only for a quick local demo without MySQL.
DB_ENGINE=mysql
DB_NAME=littlelemon
DB_USER=lemon
DB_PASSWORD=lemonpass
DB_HOST=127.0.0.1
# 3306 for a MySQL server installed on the machine,
# 3307 when using the bundled docker-compose database.
DB_PORT=3306
